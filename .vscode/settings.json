{
  "eslint.workingDirectories": [
    {
      "directory": "./web",
      "changeProcessCWD": true
    }
  ],
  "typescript.tsdk": "${workspaceFolder}/web/node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "js/ts.tsdk.path": "${workspaceFolder}/web/node_modules/typescript/lib"
}
